<Window x:Class="BazaCzesciSamochodowych.CzescWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dane części" Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F2F2F2">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTytul" Text="DODAJ CZĘŚĆ"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#C00000"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Nazwa:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtNazwa" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Producent:" Grid.Row="1" VerticalAlignment="Center"/>
            <TextBox x:Name="txtProducent" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Marka:" Grid.Row="2" VerticalAlignment="Center"/>
            <TextBox x:Name="txtMarka" Grid.Row="2" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Model:" Grid.Row="3" VerticalAlignment="Center"/>
            <TextBox x:Name="txtModel" Grid.Row="3" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Rok:" Grid.Row="4" VerticalAlignment="Center"/>
            <TextBox x:Name="txtRok" Grid.Row="4" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Numer części:" Grid.Row="5" VerticalAlignment="Center"/>
            <TextBox x:Name="txtNumer" Grid.Row="5" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Cena (zł):" Grid.Row="6" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCena" Grid.Row="6" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Stan magazynowy:" Grid.Row="7" VerticalAlignment="Center"/>
            <TextBox x:Name="txtStan" Grid.Row="7" Grid.Column="1" Margin="5"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Zapisz" Width="110" Height="38"
                    Margin="5" Background="#C00000" Foreground="White"
                    FontWeight="Bold" Click="Zapisz_Click"/>
            <Button Content="Anuluj" Width="110" Height="38"
                    Margin="5" Click="Anuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
