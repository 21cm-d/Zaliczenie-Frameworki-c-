<Window x:Class="BazaCzesciSamochodowych.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baza części samochodowych" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="BAZA CZĘŚCI SAMOCHODOWYCH"
                   FontSize="28" FontWeight="Bold"
                   Foreground="#C00000"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtSzukaj" Height="34" FontSize="15"
                     VerticalContentAlignment="Center"
                     TextChanged="txtSzukaj_TextChanged"
                     ToolTip="Wpisz nazwę, producenta, markę lub numer części"/>

            <Button Grid.Column="1" Content="＋ Dodaj" Margin="8,0,0,0"
                    Click="Dodaj_Click" Background="#C00000" Foreground="White"
                    FontWeight="Bold"/>

            <Button Grid.Column="2" Content="✎ Edytuj" Margin="8,0,0,0"
                    Click="Edytuj_Click"/>

            <Button Grid.Column="3" Content="✖ Usuń" Margin="8,0,0,0"
                    Click="Usun_Click"/>

            <Button Grid.Column="4" Content="Odśwież" Margin="8,0,0,0"
                    Click="Odswiez_Click"/>
        </Grid>

        <DataGrid x:Name="gridCzesci" Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AlternatingRowBackground="#FAFAFA"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="180"/>
                <DataGridTextColumn Header="Producent" Binding="{Binding Producent}" Width="120"/>
                <DataGridTextColumn Header="Marka" Binding="{Binding Marka}" Width="100"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="120"/>
                <DataGridTextColumn Header="Rok" Binding="{Binding Rok}" Width="70"/>
                <DataGridTextColumn Header="Numer części" Binding="{Binding NumerCzesci}" Width="130"/>
                <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat={}{0:F2} zł}" Width="90"/>
                <DataGridTextColumn Header="Stan" Binding="{Binding StanMagazynowy}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="lblLiczba"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="#555555"/>
    </Grid>
</Window>
